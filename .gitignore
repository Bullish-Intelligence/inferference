# devenv
.devenv/
.devenv.flake.nix
devenv.local.nix

# direnv
.direnv/

# python build / venv / caches
.venv/
# The library venv lives in ci/library. A worktree links ci/library to the
# main checkout's copy. Never commit that link.
/ci/library
build/
dist/
*.egg-info/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Legacy Testee 0.5 state. Testee 0.6 keeps its state outside the project.
# Keep this line until every checkout has deleted its old `.testee/`.
.testee/

# Agent-files convention (see AGENTS.md): the central Devman link plane owns
# .agents and .claude. Both are symlinks, and neither is tracked in this project.
# Write the names with no trailing slash: a trailing slash matches only a real
# directory, not a symlink.
!AGENTS.md
!CLAUDE.md
.agents
.claude

# The machine-local devenv input overlay (see devenv.yaml).
devenv.local.yaml

# llama.cpp fork build trees (build dirs, out-*, .llamacpp-builds: never commit them)
out-*/
.llamacpp-builds/

# ci/build/ is a TRACKED source dir (build-llamacpp.sh, build-manifest.md); the
# python-template `build/` ignore above must not swallow it. Build trees inside
# it (.llamacpp-builds/, out-*) stay ignored by the patterns above.
!ci/build/

# cffi bindgen build artifacts (generated by ci/gates/cffi_bindgen.py)
_llama_cffi*.so
_llama_cffi.c
_llama_cffi.o

# CI artifacts emitted by workflows (version tuples, canary report)
ci/.ci-artifacts/

# Mode A: vendored llama-cpp-python + fork tree are materialized by
# ci/build/mode-a-prep.sh (pinned clones; commits recorded in
# ci/build/vendor-manifest.json) — never committed. Mode A venv is covered by
# the .venv/ pattern above.
vendor/
ci/modea/


# Machine-local rig inventory (models, roles, cards). See rig-local.example.sh.
ci/runner/rig-local.sh

# Secrets. API keys for hosted-model baselines live here, never in tracked
# files. Copy from a machine-local source; see .env.example.
.env
.env.*
!.env.example
*.key
*.pem
secrets/

# codeeval run artifacts: raw model responses, extracted files, sandbox output.
runs/

# Measurement/log data from research spikes and benchmark runs
# (measurements/, spikes/, defect-mask-rows/ and the like).
# Driver scripts stay tracked; raw run output does not.
*.log
*.csv
*.jsonl
*.pp_table
# Test fixture logs are test INPUTS, not run output: they must be tracked.
# Without this, tests/test_experiment_residency.py reads a fixture that
# `*.log` silently swallowed, so a clean checkout failed 17 tests.
!tests/fixtures/**/*.log
# Tracked JSON Lines files: the benchmark corpora and the test fixtures.
!bench/workloads/**/*.jsonl
!tests/fixtures/**/*.jsonl

# Machine-local tool links and state.
# Write a link name with no trailing slash: a trailing slash does not match a symlink.
.envrc
.loci
.devman
.gitman
.worktrees
.jj/
# Scaffolding marker written by the repo's template manager. It names the
# source layers THIS checkout was generated from, so it is machine state, not
# repository content.
.copyroom-local
# devenv.lock and uv.lock stay tracked. Testee needs both.

# Per-machine equivalence measurements (build, device, distributions). See mixed_batch_gates.py.
ci/runner/measurements/
