+// The residency gate samples after backend initialization and before model loading.
+static unsigned long long inferference_counter(const std::filesystem::path & path) {
+    std::string text, extra;
+    std::ifstream file(path);
+    if (!std::getline(file, text) || text.empty() || std::getline(file, extra) ||
+        text.find_first_not_of("0123456789") != std::string::npos) {
+        throw std::runtime_error("residency counter unavailable: " + path.string());
+    }
+    return std::stoull(text);
+}
+
+static ggml_backend_t inferference_baseline() {
+    const char * card = std::getenv("INFERFERENCE_GTT_BASELINE_CARD");
+    if (!card) return nullptr;
+    const std::string number(card);
+    if (number.empty() || number.find_first_not_of("0123456789") != std::string::npos) {
+        throw std::runtime_error("invalid baseline card");
+    }
+    const auto path = std::filesystem::path("/sys/class/drm") / ("card" + number) / "device";
+    const auto pci = std::filesystem::canonical(path).filename().string();
+    auto device = ggml_backend_dev_by_name("Vulkan0");
+    if (!device) throw std::runtime_error("baseline Vulkan device missing");
+    ggml_backend_dev_props props{};
+    ggml_backend_dev_get_props(device, &props);
+    if (!props.device_id || pci != props.device_id) throw std::runtime_error("baseline PCI mismatch");
+    auto backend = ggml_backend_dev_init(device, nullptr);
+    if (!backend) throw std::runtime_error("baseline backend initialization failed");
+    unsigned long long gtt, vram;
+    try {
+        gtt = inferference_counter(path / "mem_info_gtt_used");
+        vram = inferference_counter(path / "mem_info_vram_used");
+    } catch (...) {
+        ggml_backend_free(backend);
+        throw;
+    }
+    fprintf(stderr, "INFERFERENCE_BASELINE card=%s pci=%s gtt=%llu vram=%llu\n", card, pci.c_str(), gtt, vram);
+    return backend;
+}
