+    if (number.empty() || number.find_first_not_of("0123456789") != std::string::npos) {
+        throw std::runtime_error("invalid baseline card");
+    }
+    const auto path = std::filesystem::path("/sys/class/drm") / ("card" + number) / "device";
+    const auto pci = std::filesystem::canonical(path).filename().string();
+    auto device = ggml_backend_dev_by_name("Vulkan0");
+    if (!device) throw std::runtime_error("baseline Vulkan device missing");
