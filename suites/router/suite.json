{
  "suite": "router",
  "branch": "library",
  "capability": {
    "probe": "probes/capability.sh",
    "required": true
  },
  "env": {
    "GPU": true,
    "MODEL_ROLE": "default",
    "MODEL_NEEDS": "any model, a matching tokenizer and LoRA probe adapters of the same architecture",
    "MODEL_VARS": [
      "MODEL_PROBE_DIR",
      "TOKENIZER_DEFAULT"
    ],
    "LIB": true
  },
  "tests": [
    "tests/test_router_context_pool_gates.py",
    "tests/test_router_cached_restore.py",
    "tests/test_router_grammar_gate.py",
    "tests/test_router_adapter_isolation.py"
  ],
  "skip_on_stock": true
}
